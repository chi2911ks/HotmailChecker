/* =========================================================
   Hotmail Checker - Premium Deep Obsidian Theme
   Design: Modern, Sleek, High-Contrast
   Color Palette: Deep Obsidian, Cyber Blue, Ruby Rose
========================================================= */

/* ── Globals ─────────────────────────────────────────── */
QWidget {
    background-color: #0f111a;
    color: #e6edf3;
    font-family: "Segoe UI Variable Text", "Inter", -apple-system, sans-serif;
    font-size: 13px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

QWidget:disabled {
    color: #484f58;
    background-color: #0d1117;
}

/* ── Main Window & Containers ─────────────────────────── */
QMainWindow {
    background-color: #0f111a;
}

QFrame#container {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
}

/* ── Inputs ──────────────────────────────────────────── */
QLineEdit, QSpinBox, QComboBox {
    background-color: #0d1117;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 8px 12px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
}

QComboBox::down-arrow {
    image: url(resources/icons/chevron-down-white.svg);
    width: 14px;
    height: 14px;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 20px;
}

QSpinBox::up-arrow {
    image: url(resources/icons/chevron-up-white.svg);
    width: 12px;
    height: 12px;
}

QSpinBox::down-arrow {
    image: url(resources/icons/chevron-down-white.svg);
    width: 12px;
    height: 12px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #3b82f6;
    background-color: #161b22;
}

QLineEdit:hover, QSpinBox:hover, QComboBox:hover {
    border: 1px solid #444c56;
}

/* ── Buttons ─────────────────────────────────────────── */
QPushButton {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #363b42;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #30363d;
    border: 1px solid #8b949e;
}

QPushButton:pressed {
    background-color: #161b22;
}

/* Primary Button (Start) */
QPushButton#primary_btn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2563eb, stop:1 #3b82f6);
    color: white;
    border: none;
    font-size: 14px;
}

QPushButton#primary_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3b82f6, stop:1 #60a5fa);
}

QPushButton#primary_btn:disabled {
    background: #1e293b;
    color: #64748b;
}

/* Danger Button (Stop) */
QPushButton#danger_btn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #991b1b, stop:1 #dc2626);
    color: white;
    border: none;
}

QPushButton#danger_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #b91c1c, stop:1 #ef4444);
}

QPushButton#danger_btn:disabled {
    background: #2d1616;
    color: #7f1d1d;
}

/* ── Table & Headers ─────────────────────────────────── */
QTableWidget {
    background-color: #0d1117;
    alternate-background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
    gridline-color: transparent;
    outline: none;
}

QHeaderView::section {
    background-color: #161b22;
    color: #8b949e;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #30363d;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
}

QTableCornerButton::section {
    background-color: #161b22;
    border: none;
    border-bottom: 2px solid #30363d;
}

QTableWidget::item {
    padding: 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #1e293b;
    color: #ffffff;
    border-radius: 0px;
}

/* ── Progress Bar ────────────────────────────────────── */
QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #161b22;
    text-align: center;
    color: transparent;
    height: 12px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3b82f6, stop:1 #60a5fa);
    border-radius: 6px;
}

/* ── Stats Label ─────────────────────────────────────── */
QLabel#stats_label {
    color: #8b949e;
    font-size: 12px;
    background: transparent;
}
